library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
entity uart_tx is
  generic (CLK_HZ : positive := 50000000; BAUD : positive := 115200);
  port (clk : in std_logic; reset_n : in std_logic; start : in std_logic;
        data_in : in std_logic_vector(7 downto 0); tx : out std_logic; busy : out std_logic);
end entity;
architecture rtl of uart_tx is
  constant DIVISOR : positive := (CLK_HZ + BAUD/2)/BAUD;
  signal timer : integer range 0 to DIVISOR-1 := 0;
  signal bits_left : integer range 0 to 10 := 0;
  signal frame : std_logic_vector(9 downto 0) := (others => '1');
begin
  tx <= frame(0) when bits_left /= 0 else '1';
  busy <= '1' when bits_left /= 0 else '0';
  process(clk)
  begin
    if rising_edge(clk) then
      if reset_n='0' then
        timer<=0; bits_left<=0; frame<=(others=>'1');
      elsif bits_left=0 then
        if start='1' then
          frame <= '1' & data_in & '0';
          bits_left <= 10;
          timer <= 0;
        end if;
      elsif timer=DIVISOR-1 then
        timer<=0;
        frame <= '1' & frame(9 downto 1);
        bits_left<=bits_left-1;
      else
        timer<=timer+1;
      end if;
    end if;
  end process;
end architecture;

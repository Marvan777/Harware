library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
entity uart_rx is
  generic (CLK_HZ : positive := 50000000; BAUD : positive := 115200);
  port (clk : in std_logic; reset_n : in std_logic; rx : in std_logic;
        data_out : out std_logic_vector(7 downto 0); valid : out std_logic);
end entity;
architecture rtl of uart_rx is
  constant DIVISOR : positive := (CLK_HZ + BAUD/2)/BAUD;
  signal meta, sync_rx : std_logic := '1';
  signal timer : integer range 0 to DIVISOR := 0;
  signal bit_num : integer range 0 to 9 := 0;
  signal active : std_logic := '0';
  signal shift : std_logic_vector(7 downto 0) := (others=>'0');
begin
  process(clk)
  begin
    if rising_edge(clk) then
      meta<=rx; sync_rx<=meta; valid<='0';
      if reset_n='0' then
        active<='0'; timer<=0; bit_num<=0; valid<='0'; data_out<=(others=>'0');
      elsif active='0' then
        if sync_rx='0' then
          active<='1'; timer<=DIVISOR/2; bit_num<=0;
        end if;
      elsif timer>0 then
        timer<=timer-1;
      elsif bit_num=0 then
        if sync_rx='0' then
          bit_num<=1; timer<=DIVISOR-1;
        else
          active<='0';
        end if;
      elsif bit_num<=8 then
        shift(bit_num-1)<=sync_rx;
        bit_num<=bit_num+1; timer<=DIVISOR-1;
      else
        if sync_rx='1' then
          data_out<=shift; valid<='1';
        end if;
        active<='0';
      end if;
    end if;
  end process;
end architecture;
